# Copy to /etc/pressdigest/caddy.env on the VM (setup.sh does this if the
# file doesn't already exist) and fill in real values. Read by the caddy
# process via a systemd drop-in (setup.sh installs
# /etc/systemd/system/caddy.service.d/override.conf) - not a secret in
# the same sense as GEMINI_API_KEY (a bcrypt hash isn't reversible), but
# still not something to commit filled in.

# Before DNS/443 are ready: leave as-is, bare HTTP on port 80, no TLS
# attempted. Once the DuckDNS hostname resolves and port 443 is open,
# change this to the hostname itself (e.g. pressdigest.duckdns.org, no
# scheme) and restart caddy - that alone is what triggers automatic TLS.
SITE_ADDRESS=http://:80

BASIC_AUTH_USER=

# Generate with: caddy hash-password --plaintext '<your password>'
BASIC_AUTH_HASH=
