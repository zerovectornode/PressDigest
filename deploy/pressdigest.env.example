# Copy this to /etc/pressdigest/pressdigest.env on the VM (setup.sh does
# this on first run if the file doesn't already exist) and fill in the
# real key. Never commit the filled-in version - see setup.sh, which sets
# this file's permissions to 600, root:root.

GEMINI_API_KEY=

# Safety margin against the e2-micro's shared-core CPU (default in
# config/default.yaml is 4) - see config.py's _apply_env_overrides and
# design/DESIGN.md "Deployment: GCP e2-micro VM".
HINDU_EXTRACT_MAX_CONCURRENT=2

# INFO in normal operation; DEBUG if you're troubleshooting a specific
# problem and want to see it in `journalctl -u pressdigest`.
LOG_LEVEL=INFO
