# Copy to /etc/pressdigest/env on the VM (setup.sh does this if the file
# doesn't already exist) and fill in the real key. Never commit the
# filled-in version - setup.sh sets this file's permissions to 600,
# root:root; systemd reads it as root before pressdigest.service drops to
# the low-privilege service user, so the key is never exposed via that
# user's own filesystem permissions.
#
# Non-secret settings (HINDU_EXTRACT_MAX_CONCURRENT, HINDU_EXTRACT_DATA_ROOT,
# LOG_LEVEL) live as plain Environment= lines in pressdigest.service
# instead of here, on purpose - they're not sensitive, and keeping them in
# the versioned unit file means they show up in a diff instead of only
# existing invisibly on the VM.

GEMINI_API_KEY=
